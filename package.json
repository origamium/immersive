{
  "name": "my-vue-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "engineStrict": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
