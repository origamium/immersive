{
  "name": "immersive-acoustic-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "engineStrict": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-cloud.mjs",
    "native:test": "swift test --package-path native",
    "native:mac": "sh native/package-mac.sh",
    "native:ios": "xcodebuild -project native/iOS/AcousticIOS.xcodeproj -target AcousticIOS -configuration Debug -sdk iphonesimulator CODE_SIGNING_ALLOWED=NO build",
    "native:tv": "node native/generate-project.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.11",
    "fflate": "^0.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.182.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.8",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee"
}
